APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

# Render provides DATABASE_URL (postgres://user:pass@host:port/dbname)
# DATABASE_URL=postgres://user:pass@host:port/dbname

# Or use individual vars (DB_* takes precedence over DATABASE_URL if set)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=snipt
DB_USER=root
DB_PASS=

IP_PEPPER=change-me-to-a-random-string
TOKEN_SECRET=change-me-to-another-random-string
